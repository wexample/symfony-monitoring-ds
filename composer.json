{
  "name": "wexample/symfony-monitoring-ds",
  "description": "Design-system screens of symfony-monitoring: the incidents and their decisions, the heartbeats",
  "version": "2.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMonitoringDs\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/validator": "^7.4 || ^8.0",
    "wexample/symfony-api": ">=18.0.0",
    "wexample/symfony-design-system": ">=48.0.0",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-loader": ">=28.0.0",
    "wexample/symfony-monitoring": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}